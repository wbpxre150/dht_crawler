{
 "note": "write base64 -> a temp file, then cram_load() it; expect load_ok or a clean rejection (no crash)",
 "layout": "see the cram.bin header comment in scripts/cram_export.py",
 "cases": [
  {
   "name": "valid",
   "expect": "load_ok",
   "reason": "4 columns, 4 nonzeros, 48 states -- the round-trip case",
   "ncols": 4,
   "rowptr": [
    0,
    2,
    3,
    3,
    4
   ],
   "out_cols": [
    0,
    21,
    12,
    1
   ],
   "weights": [
    0.5,
    -1.25,
    0.75,
    2.0
   ],
   "base64": ""
  },
  {
   "name": "bad_magic",
   "expect": "reject",
   "reason": "magic is XRAM, not CRAM",
   "base64": ""
  },
  {
   "name": "bad_version",
   "expect": "reject",
   "reason": "format_version 2 is not supported",
   "base64": ""
  },
  {
   "name": "truncated",
   "expect": "reject",
   "reason": "the file ends before the rowptr does",
   "base64": "Q1JBTQEAAAAEAAAAHAAAADAAAAAMAAAABwAAAAIAAAAEAAAAQAAAAFQAAABoAAAA2AAAAGgBAABwAQAAAAAAAAAAAAACAAAA"
  },
  {
   "name": "rowptr_not_monotonic",
   "expect": "reject",
   "reason": "rowptr[2] < rowptr[1]",
   "base64": ""
  },
  {
   "name": "rowptr_tail_wrong",
   "expect": "reject",
   "reason": "rowptr[-1] != nnz",
   "base64": ""
  },
  {
   "name": "out_col_out_of_range",
   "expect": "reject",
   "reason": "an entry names output column 40 of 28",
   "base64": ""
  },
  {
   "name": "ncols_mismatch",
   "expect": "reject",
   "reason": "the header claims 5 columns, the rowptr holds 5 entries",
   "base64": ""
  },
  {
   "name": "file_bytes_mismatch",
   "expect": "reject",
   "reason": "the header's file_bytes disagrees with the real size",
   "base64": ""
  }
 ]
}
