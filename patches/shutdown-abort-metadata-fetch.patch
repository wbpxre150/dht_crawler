--- a/src/tree_metadata.c
+++ b/src/tree_metadata.c
@@ -1312,7 +1312,13 @@
 
     int next_peer = 0;  /* Next untried peer index */
     tree_torrent_metadata_t *result = NULL;
-    time_t global_start = time(NULL);
+    /* Monotonic deadline instead of time(NULL) seconds (patch 24). The old
+     * check fired on the first tick whose difftime(now, start) was >
+     * metadata_timeout / 1000, so a 60 s budget really ran for up to 61 s - and
+     * that overrun was the difference between the app's SIGTERM grace and a
+     * SIGKILL in the middle of the exit-time WAL checkpoint. now_ms() already
+     * exists here for the per-piece re-ask cooldown. */
+    int64_t global_start_ms = now_ms();
 
     /* Fill initial window */
     int active_count = 0;
@@ -1349,9 +1355,30 @@
 
     /* Main poll loop */
     while (active_count > 0 && !result) {
+        /* Shutdown abort (patch 24). A fetch in flight when the whole crawler is
+         * being torn down must not run to the global deadline: the metadata
+         * workers only re-check the stop between fetches, and
+         * thread_tree_destroy() joins them unbounded, so one 60 s attempt held
+         * the entire process stop (settings apply, app exit, maintenance
+         * one-shots) for a full minute - and with 64 trees x 10 metadata
+         * workers at least one attempt is always just starting, which is why the
+         * stop was a constant ~60 s. The poll below ticks at 500 ms, so the
+         * attempt is abandoned within half a second.
+         *
+         * Gated on the REASON, exactly like the worker loop in
+         * tree_metadata_worker_func(): SHUTDOWN_REASON_RATE_BASED is an ordinary
+         * tree respawn and must keep its in-flight attempts, otherwise every
+         * respawn would throw away the work in progress. No failure counter is
+         * touched here - this is a shutdown, not a peer failure - and the close
+         * loop after the poll releases the slots the same way the deadline
+         * break does. */
+        if (tree && atomic_load(&tree->shutdown_reason) == SHUTDOWN_REASON_SUPERVISOR) {
+            break;
+        }
+
         /* Check global timeout. One deadline event per attempt, not per
          * connection: every window slot still live here is abandoned together. */
-        if (difftime(time(NULL), global_start) > metadata_timeout / 1000) {
+        if (now_ms() - global_start_ms > metadata_timeout) {
             meta_count_fail(tree, META_FAIL_DEADLINE);
             break;
         }
