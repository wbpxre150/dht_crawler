+    CHECK(st.refused == RACE_THREADS - 1, "%d refusals, got %llu", RACE_THREADS - 1,
+          (unsigned long long)st.refused);
+
+    pthread_barrier_destroy(&barrier);
+    inflight_set_destroy(set);
+}
