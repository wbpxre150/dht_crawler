+    container = cram_container_load(CRAM_TEST_MODEL_DIR "/cram.bin", NULL);
+    CHECK(container != NULL, "cannot load the container for the row checks");
+    if (!container) {
+        cram_free(model);
+        printf("test_cram: %d check(s) FAILED\n", failures);
+        return 1;
