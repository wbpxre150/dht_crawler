+        if (cfrc != 0) {
+            log_msg(LOG_ERROR, "--category-filter-update failed (%d); original database kept", cfrc);
+            database_cleanup(&g_database);
+            torrent_search_cleanup();
+            hard_block_cleanup();
+            language_filter_cleanup();
+            bloom_filter_cleanup(g_bloom);
+            cleanup_app_context(&g_app_ctx);
+            return cfrc;
+        }
+        /* The purge is only half the job: always compact afterwards. */
+        compact_db = true;
+    }
