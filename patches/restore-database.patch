+/* Chunk size for the incremental statement buffer in database_restore(). */
+#define RESTORE_READ_CHUNK 65536
+
+/* True when [buf]/[len] holds only whitespace (a harmless trailing tail). */
+static int restore_is_blank(const char *buf, size_t len) {
+    for (size_t i = 0; i < len; i++) {
+        char c = buf[i];
+        if (c != ' ' && c != '\t' && c != '\n' && c != '\r') return 0;
+    }
+    return 1;
+}
+
+/*
+ * Append more data from [fp] to the statement buffer, growing it as
+ * needed. Returns 1 on success (a clean EOF sets *eof), 0 on an I/O or
+ * allocation failure.
+ */
+static int restore_read_more(char **buf, size_t *cap, size_t *len, FILE *fp, int *eof) {
+    if (*eof) return 1;
+    while (*len + RESTORE_READ_CHUNK > *cap) {
+        size_t ncap = *cap * 2;
+        char *nb = realloc(*buf, ncap);
+        if (!nb) {
+            log_msg(LOG_ERROR, "restore: out of memory growing statement buffer");
+            return 0;
+        }
+        *buf = nb;
+        *cap = ncap;
+    }
+    size_t nread = fread(*buf + *len, 1, *cap - *len, fp);
+    *len += nread;
+    if (nread == 0) *eof = 1;
+    return 1;
+}
+
+/* Replay a plain (uncompressed) SQL dump into a fresh database.
+ * Opens dst_path, creates the full schema (tables + FTS + triggers), then
+ * streams sql_path statement by statement into one transaction. Statements
+ * are extracted incrementally with sqlite3_prepare_v2: the dump may contain
+ * raw newlines inside quoted text, so neither line-by-line nor fixed-size
+ * reads are safe. The AFTER-INSERT triggers populate the FTS indexes during
+ * the replay (external-content FTS, same as the live database).
+ * FK checks are disabled while the dump is replayed (the dump order is
+ * path_prefixes -> torrents -> torrent_files, but OR IGNORE skips can make
+ * a child reference a row that was ignored). On any SQL error the
+ * transaction is rolled back, dst_path (and its WAL/SHM sidecars) are
+ * unlinked, and -1 is returned — the caller's original database is never
+ * touched. Returns the number of statements replayed, or -1 on failure. */
+int database_restore(const char *sql_path, const char *dst_path) {
+    if (!sql_path || !dst_path) return -1;
+
+    sqlite3 *db = NULL;
+    FILE *fp = NULL;
+    char *buf = NULL;
+    int rc = sqlite3_open(dst_path, &db);
+    if (rc != SQLITE_OK) {
+        log_msg(LOG_ERROR, "restore: failed to open destination %s: %s",
+                dst_path, sqlite3_errmsg(db));
+        sqlite3_close(db);
+        unlink(dst_path);
+        return -1;
+    }
+
+    sqlite3_exec(db, "PRAGMA journal_mode=WAL;", NULL, NULL, NULL);
+    sqlite3_exec(db, "PRAGMA foreign_keys=OFF;", NULL, NULL, NULL);
+
+    char *err = NULL;
+    rc = sqlite3_exec(db, CREATE_TABLES_SQL, NULL, NULL, &err);
+    if (rc != SQLITE_OK) {
+        log_msg(LOG_ERROR, "restore: failed to create tables: %s", err);
+        sqlite3_free(err);
+        goto fail;
+    }
+    rc = sqlite3_exec(db, CREATE_FTS_SQL, NULL, NULL, &err);
+    if (rc != SQLITE_OK) {
+        log_msg(LOG_ERROR, "restore: failed to create FTS tables: %s", err);
+        sqlite3_free(err);
+        goto fail;
+    }
+    rc = sqlite3_exec(db, CREATE_TRIGGERS_SQL, NULL, NULL, &err);
+    if (rc != SQLITE_OK) {
+        log_msg(LOG_ERROR, "restore: failed to create triggers: %s", err);
+        sqlite3_free(err);
+        goto fail;
+    }
+
+    fp = fopen(sql_path, "rb");
+    if (!fp) {
+        log_msg(LOG_ERROR, "restore: failed to open dump %s: %s", sql_path, strerror(errno));
+        goto fail;
+    }
+
+    rc = sqlite3_exec(db, "BEGIN;", NULL, NULL, &err);
+    if (rc != SQLITE_OK) {
+        log_msg(LOG_ERROR, "restore: failed to begin transaction: %s", err);
+        sqlite3_free(err);
+        goto fail;
+    }
+
+    size_t cap = RESTORE_READ_CHUNK;
+    size_t len = 0;
+    int eof = 0;
+    int statements = 0;
+    buf = malloc(cap);
+    if (!buf) {
+        log_msg(LOG_ERROR, "restore: out of memory allocating statement buffer");
+        goto fail;
+    }
+
+    for (;;) {
+        const char *tail = NULL;
+        sqlite3_stmt *stmt = NULL;
+        rc = sqlite3_prepare_v2(db, buf, (int)len, &stmt, &tail);
+        if (rc != SQLITE_OK) {
+            /* Incomplete statement: accumulate more input, unless the file
+             * is exhausted (then the remainder must be blank to be legal). */
+            if (eof) {
+                if (restore_is_blank(buf, len)) break;
+                log_msg(LOG_ERROR, "restore: trailing incomplete statement at end of dump: %s",
+                        sqlite3_errmsg(db));
+                goto fail;
+            }
+            if (!restore_read_more(&buf, &cap, &len, fp, &eof)) goto fail;
+            continue;
+        }
+        if (stmt) {
+            int step_rc = sqlite3_step(stmt);
+            sqlite3_finalize(stmt);
+            if (step_rc != SQLITE_DONE) {
+                log_msg(LOG_ERROR, "restore: statement %d failed: %s",
+                        statements + 1, sqlite3_errmsg(db));
+                goto fail;
+            }
+            statements++;
+            if (statements % 10000 == 0)
+                log_msg(LOG_INFO, "restore: %d statements replayed...", statements);
+        }
+        /* [tail] points just past the consumed input: a statement (when
+         * [stmt] was set) and/or any leading comments/whitespace. Nothing
+         * was consumed when tail == buf (empty buffer or comments-only
+         * input) — in that case just fetch more input (or stop at EOF).
+         * The unconsumed tail may itself hold a complete statement, so
+         * loop again before reading more. */
+        size_t consumed = tail ? (size_t)(tail - buf) : 0;
+        if (consumed > 0) {
+            memmove(buf, tail, len - consumed);
+            len -= consumed;
+            if (len > 0) continue;
+        }
+        if (eof) break;
+        if (!restore_read_more(&buf, &cap, &len, fp, &eof)) goto fail;
+    }
+
+    rc = sqlite3_exec(db, "COMMIT;", NULL, NULL, &err);
+    if (rc != SQLITE_OK) {
+        log_msg(LOG_ERROR, "restore: commit failed: %s", err);
+        sqlite3_free(err);
+        goto fail;
+    }
+    sqlite3_exec(db, "PRAGMA foreign_keys=ON;", NULL, NULL, NULL);
+
+    /* Checkpoint + truncate WAL so the restored DB is self-contained
+     * before the caller renames it over the original. */
+    {
+        int nLog = 0, nCkpt = 0;
+        int ckpt_rc = sqlite3_wal_checkpoint_v2(db, NULL, SQLITE_CHECKPOINT_TRUNCATE, &nLog, &nCkpt);
+        if (ckpt_rc != SQLITE_OK)
+            log_msg(LOG_WARN, "restore: WAL checkpoint returned %d: %s (%d/%d frames)",
+                    ckpt_rc, sqlite3_errstr(ckpt_rc), nCkpt, nLog);
+    }
+
+    free(buf);
+    fclose(fp);
+    sqlite3_close(db);
+    log_msg(LOG_INFO, "restore: %d statements replayed into %s", statements, dst_path);
+    return statements;
+
+fail:
+    sqlite3_exec(db, "ROLLBACK;", NULL, NULL, NULL);
+    free(buf);
+    if (fp) fclose(fp);
+    sqlite3_close(db);
+    /* The original database must survive: drop the partial destination. */
+    unlink(dst_path);
+    {
+        char side[PATH_MAX + 8];
+        snprintf(side, sizeof(side), "%s-wal", dst_path);
+        unlink(side);
+        snprintf(side, sizeof(side), "%s-shm", dst_path);
+        unlink(side);
+    }
+    return -1;
+}
